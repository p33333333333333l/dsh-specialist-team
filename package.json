{
  "name": "dsh-specialist-team",
  "version": "0.4.4",
  "description": "Structured specialist assignments and role-scoped tool guards for native DSH Agent Teams",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "client.js",
    "locale/*.json",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "NOTICE",
    "NOTICE.zh-CN",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.4",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-agent-team": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.2-rc.4",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "icon": "docs/team-icon.svg"
}
