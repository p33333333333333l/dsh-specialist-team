{
  "name": "dsh-specialist-team",
  "version": "0.2.3",
  "description": "Task routing, structured specialist assignments and role-scoped tool guards for DSH",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./team": "./vendor/agent-team.mjs",
    "./tools": "./vendor/tool-agent-team.mjs",
    "./team/icon": "./docs/team-service-icon.svg",
    "./tools/icon": "./docs/team-tools-icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./team/locale/*.json": "./locale/team/*.json",
    "./tools/locale/*.json": "./locale/tools/*.json"
  },
  "license": "Apache-2.0 AND MIT",
  "files": [
    "src",
    "vendor",
    "client.js",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "icon": "docs/team-icon.svg"
}
