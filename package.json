  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./team": "./vendor/agent-team.mjs",
    "./tools": "./vendor/tool-agent-team.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./team/locale/*.json": "./locale/team/*.json",
    "./tools/locale/*.json": "./locale/tools/*.json"
  },
  "license": "MIT",
  "files": ["src", "vendor", "locale", "docs", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "scripts": {"test": "node --test test/*.test.mjs"},
  "engines": {"node": ">=22", "dsh": "0.2.1-rc.3"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "zod": "^4.4.3"
  },
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}}
}
