diff --git a/scripts/build-specialist-team-local.ts b/scripts/build-specialist-team-local.ts
new file mode 100644
index 0000000000..f3d0fe9978
--- /dev/null
+++ b/scripts/build-specialist-team-local.ts
@@ -0,0 +1,48 @@
+/** Build same-release Team backports while sharing every runtime-owned dependency. */
+import { mkdirSync, readFileSync, realpathSync, symlinkSync, existsSync, writeFileSync } from 'node:fs'
+import { resolve, join } from 'node:path'
+import { parseArgs } from 'node:util'
+import { build } from 'tsdown'
+
+const root = resolve(import.meta.dirname, '..')
+const { values } = parseArgs({ options: { runtime: { type: 'string' }, out: { type: 'string' } } })
+if (!values.runtime || !values.out) throw new Error('usage: node scripts/build-specialist-team-local.ts --runtime <installed-dsh-root> --out <local-plugin-directory>')
+const runtime = realpathSync(values.runtime)
+const outDir = resolve(values.out)
+const version = JSON.parse(readFileSync(join(root, 'packages/experimental/agent-team/package.json'), 'utf8')).version
+const installed = JSON.parse(readFileSync(join(runtime, 'node_modules/@deepseek-ai/dsh-experimental-agent-team/package.json'), 'utf8')).version
+if (installed !== version) throw new Error(`Team backport requires runtime ${version}; found ${installed}`)
+const modules = realpathSync(join(runtime, 'node_modules'))
+mkdirSync(outDir, { recursive: true })
+const link = join(outDir, 'node_modules')
+if (existsSync(link)) {
+  if (realpathSync(link) !== modules) throw new Error('output node_modules must resolve to the selected runtime')
+} else {
+  symlinkSync(modules, link, 'dir')
+}
+// Bundle the three new helper exports; older runtime package exports lack them.
+// Keep Cordis, LLM, projections, and all other peers owned by the installed runtime.
+const helpers = ['model-selection', 'model-selection-state', 'list-models']
+const helperImports = helpers.map(name => `@deepseek-ai/dsh-tool-subagent/${name}`)
+await build({
+  config: false,
+  cwd: root,
+  entry: {
+    'agent-team': join(root, 'packages/experimental/agent-team/src/index.ts'),
+    'tool-agent-team': join(root, 'packages/experimental/tool-agent-team/src/index.ts'),
+    'tool-subagent': join(root, 'packages/subagent/tool-subagent/src/index.ts'),
+  },
+  outDir,
+  platform: 'node',
+  target: 'es2024',
+  format: ['esm'],
+  dts: false,
+  clean: false,
+  deps: {
+    alwaysBundle: helperImports,
+    neverBundle: id => !id.startsWith('.') && !id.startsWith('/') && !helperImports.includes(id),
+  },
+  outExtensions: () => ({ js: '.mjs' }),
+})
+writeFileSync(join(outDir, 'build-info.json'), `${JSON.stringify({ version, source: root, runtime, helpers }, null, 2)}\n`)
+console.log(`Local Team modules: ${outDir}`)
