+    '  config: { agents: [] }',
+    '- name: cordis:subagents',
+    '- name: cordis:spawn',
+    '- name: cordis:fork',
+    '- name: cordis:settings',
+    '  config:',
+    '    enabled: true',
+    '    allowedModels:',
+    '      - { provider: mock, model: mock }',
+    '      - { provider: mock, model: specialist }',
+    '- name: cordis:team',
+    ...(first === 'tools' ? [
