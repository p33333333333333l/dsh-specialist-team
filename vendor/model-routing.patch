+  expect(ctx.tools.get('spawn_teammate', lead) === undefined).toBe(disposeFirst === 'tools')
+  expect(ctx.tools.get('subagent', lead) === undefined).toBe(disposeFirst === 'ordinary')
+  const remainingDiscovery = await ctx.tools.execute({
+    callId: ToolCallId('loader-remaining-discovery'), name: 'list_subagent_models', agent: lead,
+    arguments: {}, signal: new AbortController().signal,
+  })
