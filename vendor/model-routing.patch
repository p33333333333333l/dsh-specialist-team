+  await ctx.loader.await()
+  const adapter = new MockAdapter(['hang', 'hang'])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const lead = await ctx.agentLoop.create(SessionId('loader-specialist-lead'), { provider: 'mock', model: 'mock' })
+  const ordinaryFiber = lead.ctx.plugin(ToolSubagent, { provider: 'spawn', maxDepth: 2, modelSelectionSettings: true })
+  await ordinaryFiber
